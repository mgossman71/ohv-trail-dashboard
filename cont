#!/bin/bash
# OHV Trail Dashboard - Container Management Script

cd /root/.openclaw/workspace/ohv-trail-dashboard

case "$1" in
    start)
        echo "Starting containers..."
        docker compose up -d
        echo "View logs: docker compose logs -f ohv-trail-dashboard"
        ;;
    stop)
        echo "Stopping containers..."
        docker compose down
        ;;
    restart)
        echo "Restarting containers..."
        docker compose down
        docker compose up -d
        ;;
    logs)
        echo "Container logs (last 50 lines):"
        docker compose logs --tail=50 ohv-trail-dashboard
        ;;
    status)
        echo "Container status:"
        docker compose ps
        ;;
    init)
        echo "Initializing database..."
        docker compose exec ohv-trail-dashboard python init_container_db.py
        ;;
    shell)
        echo "Opening shell in container..."
        docker compose exec ohv-trail-dashboard /bin/bash
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|logs|status|init|shell}"
        exit 1
        ;;
esac
